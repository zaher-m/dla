# Copy to .env and edit. Every value here overrides the matching key in
# config/dla.yaml, so a deployment never has to edit tracked configuration.
#
#   cp .env.example .env

# --- service ---------------------------------------------------------------
DLA_SERVER_PORT=8080
DLA_CONTAINER=dla
DLA_IMAGE=dla-suite:1.0

# --- what runs -------------------------------------------------------------
# One of the files in config/profiles: fast | balanced | full | cpu | segmentation
DLA_RUN_PROFILE=balanced
# Hard ceiling on pages per analysis. A 300-page report through 16 models is
# tens of thousands of inferences.
DLA_SELECTION_MAX_PAGES=25

# --- storage ---------------------------------------------------------------
# Point this at a shared Hugging Face cache if you have one; several systems
# pull the same backbones and it saves tens of gigabytes.
# DLA_HF_CACHE=/path/to/hf-cache

# --- hardware --------------------------------------------------------------
DLA_SHM_SIZE=16gb
OMP_NUM_THREADS=8
# Set to 1 to forbid any network fetch from the Hugging Face hub at run time.
HF_HUB_OFFLINE=0

# Re-enable cuDNN. Leave unset unless you are investigating the guard in
# harness/core/torch_env.py; with cuDNN on, some devices return silently wrong
# convolution results for these backbones.
# DLA_ALLOW_CUDNN=1
